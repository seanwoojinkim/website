---
// KoiBackground.astro — ambient koi behind every page, from the shared `wooj-koi`
// package (framework-agnostic; p5 is loaded from a CDN on demand by the library).
// This wrapper owns the portfolio-specific framing: transition:persist (the canvas
// survives view transitions), the once-only init guard, and the theme-aware styling.
---

<div id="koi-canvas" transition:name="koi-canvas" transition:persist></div>

<script>
  import { createKoiBackground } from 'wooj-koi';

  async function initKoi() {
    if (window.__woojKoiStarted) return; // survive view transitions — init once
    window.__woojKoiStarted = true;
    try {
      await createKoiBackground({ container: '#koi-canvas', assetBase: '/koi', count: 5 });
    } catch (e) {
      window.__woojKoiStarted = false; // let a later navigation retry
    }
  }
  initKoi();
  document.addEventListener('astro:after-swap', initKoi);
</script>

<style>
  #koi-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: auto;  /* Enable mouse interaction */
    opacity: 0.6;
    transition: opacity 0.5s ease;
  }

  html.dark-mode #koi-canvas {
    opacity: 0.5;  /* Slightly reduced for dark mode */
  }
</style>
